CREATE TABLE IF NOT EXISTS jellyfin_favorites (
    scope_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (scope_id, item_id)
);

selectAll:
SELECT item_id FROM jellyfin_favorites WHERE scope_id = ?;

upsert:
INSERT OR REPLACE INTO jellyfin_favorites(scope_id, item_id, updated_at) VALUES (?, ?, ?);

delete:
DELETE FROM jellyfin_favorites WHERE scope_id = ? AND item_id = ?;

clear:
DELETE FROM jellyfin_favorites WHERE scope_id = ?;
