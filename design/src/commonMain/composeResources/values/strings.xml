    <string name="privacy_title">Permissions &amp; privacy</string>
    <string name="privacy_summary">Jellystack has no analytics, advertising, tracking, or automatic log uploads. It connects directly to the Jellyfin and Seerr servers you configure and protects server tokens in the device credential store.</string>
    <string name="privacy_network_title">Network access</string>
    <string name="privacy_network_body">Required to connect directly to your servers and stream media. Jellystack does not route traffic through a developer-operated cloud.</string>
    <string name="privacy_cast_title">Nearby devices or location</string>
    <string name="privacy_cast_body">Requested only after you choose Cast. Android 13+ uses Nearby devices; Android 12 and earlier require location permission for local device discovery.</string>
    <string name="privacy_notifications_title">Cast notifications</string>
    <string name="privacy_notifications_body">Requested only during an active Cast session so playback controls can remain available. Cast continues if you decline.</string>
    <string name="privacy_local_storage_title">Downloads</string>
    <string name="privacy_local_storage_body">Downloads stay in app-specific storage. Jellystack does not request access to your photos, media, USB storage, or phone identity.</string>
    <string name="privacy_app_lock_title">Optional app lock</string>
    <string name="privacy_app_lock_body">Biometric authentication is used only when you enable App Lock. Biometric data remains managed by Android and is never read or stored by Jellystack.</string>
